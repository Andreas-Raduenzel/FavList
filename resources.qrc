<RCC>
    <!-- QML-Datei -->
    <qresource prefix="/qml">
        <file alias="main.qml">qml/main.qml</file>
    </qresource>

    <!-- Icon (SVG, passender Name für :/icons/appicon.svg) -->
    <qresource prefix="/icons">
        <file alias="appicon.svg">resources/icons/appicon.svg</file>
    </qresource>
</RCC>
